MODEL_DIR=/path/to/your/SenseVoiceSmall
DEVICE=cpu
# 数据库文件路径（相对路径按项目根目录解析，也可写绝对路径）
DB_PATH=data/phonetics.db

# ASR 引擎: sensevoice（默认，整段识别） | paraformer-streaming（流式）
ASR_MODEL=sensevoice

# 流式模型的模型名或本地路径（ASR_MODEL=paraformer-streaming 时生效）
# 默认优先使用项目根目录 models/paraformer-zh-streaming，不存在时回退到在线别名
# 相对路径按项目根目录解析，也可以写绝对路径
STREAMING_MODEL_DIR=models/paraformer-zh-streaming

# 流式标点模型（ct-punc）的模型名或本地路径
# 默认优先使用项目根目录 models/ct-punc
# 相对路径按项目根目录解析，也可以写绝对路径
STREAMING_PUNC_MODEL_DIR=models/ct-punc

# 流式 chunk 粒度（毫秒），默认 600；CPU 压力大时可调大到 960
ASR_STREAM_CHUNK_MS=600

# 流式最终文本是否补标点（ct-punc），默认开启
ASR_PUNC=true
