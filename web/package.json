{
  "name": "phonetics-2",
  "productName": "Phonetics-2",
  "version": "0.1.0",
  "description": "多语音理解桌面客户端（Electron + React）",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:renderer": "vite",
    "build": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json && node node_modules/vite/bin/vite.js build",
    "dist": "electron-builder --win nsis --config electron-builder.yml",
    "dist:mac": "electron-builder --mac dmg --config electron-builder.yml"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
